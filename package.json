{
  "name": "@dmc/ui-v4",
  "version": "4.1.0",
  "description": "DMC UI v4 — design tokens, styles and React primitives",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "style": "./dist/dmc-v4.css",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/dmc-v4.css": "./dist/dmc-v4.css",
    "./dmc-v4.css": "./dist/dmc-v4.css"
  },
  "sideEffects": [
    "*.css",
    "dist/*.css"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.docs.config.js",
    "docs": "vite --config vite.docs.config.js",
    "docs:build": "vite build --config vite.docs.config.js",
    "docs:preview": "vite preview --config vite.docs.config.js",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^5.4.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://your-git.example.com/dmc-ui-v4.git"
  },
  "license": "UNLICENSED",
  "private": true
}
